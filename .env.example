# Copia este archivo como .env.local y llena los valores reales.
# .env.local está en .gitignore: nunca subas secretos al repo.
# Estas mismas 6 variables hay que cargarlas en Vercel (Settings → Environment Variables).

# ── Base de datos ────────────────────────────────────────────────────────────
# Neon → Dashboard → Connection Details. Crea el proyecto en us-east-1 para que
# quede junto a las funciones de Vercel (iad1) y no pagues latencia por query.
DATABASE_URL=

# ── Acceso al panel ──────────────────────────────────────────────────────────
# Contraseña compartida del panel /admin. Mínimo 12 caracteres, generada al azar.
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres.
# Si lo cambias, todas las sesiones abiertas se invalidan.
#   openssl rand -base64 32
SESSION_SECRET=

# ── Google Calendar ──────────────────────────────────────────────────────────
# Correo LITERAL de la cuenta de Google del barbero (ej. diego@gmail.com).
# OJO: no pongas "primary" — eso apunta al calendario de la cuenta de servicio,
# no al del barbero. Es el error más común de este setup.
GOOGLE_CALENDAR_ID=

# Cuenta de servicio creada en Google Cloud (campo "client_email" del JSON).
# El barbero debe compartir su calendario con este correo, con permiso
# "Hacer cambios en los eventos".
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Campo "private_key" del JSON de la cuenta de servicio, entre comillas dobles
# y con los saltos de línea escapados como \n, tal como viene en el JSON.
GOOGLE_PRIVATE_KEY=
